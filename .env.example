DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Required explicit source scope. Comma-separated numeric IDs.
LOG_GUILD_IDS=
LOG_CHANNEL_IDS=
# Forum/text parent IDs include their cached threads. Exclusions win.
LOG_EXCLUDE_CHANNEL_IDS=
LOG_ALL_CHANNELS=false
LOG_BOTS=false
MESSAGE_CONTENT_INTENT=true
ARCHIVE_ATTACHMENTS=true
ARCHIVE_MAX_FILE_BYTES=8388608
ARCHIVE_MAX_TOTAL_BYTES=16777216
ARCHIVE_MAX_FILES=4
ARCHIVE_CONTENT_TYPES=image/*,audio/*,video/*,text/plain,application/pdf,application/octet-stream
QUEUE_SIZE=20
CACHE_SIZE=500
